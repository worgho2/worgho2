{
  "name": "worgho2",
  "version": "0.0.0",
  "description": "GitHub profile README with an animated 3D contribution graph.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Otávio Baziewicz Filho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/worgho2/worgho2.git"
  },
  "homepage": "https://github.com/worgho2/worgho2#readme",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node src/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.4",
    "lefthook": "^2.1.14",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
